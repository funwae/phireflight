<nav class="bg-slate-950 border-b border-slate-800 h-16">
  <div class="max-w-6xl mx-auto px-4 h-full flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-3">
        <img src={~p"/images/phireflight-logo.png"} alt="PhireFlight" class="h-8 w-8" onerror="this.style.display='none'" />
        <span class="text-xl font-semibold text-slate-100 tracking-tight">PhireFlight</span>
      </a>
      <span class="text-xs text-slate-400">Phoenix Context Flight Recorder</span>
    </div>
    <div class="flex items-center gap-6 text-sm font-medium text-slate-300">
      <.link navigate={~p"/apps"} class="hover:text-orange-400 transition-colors">
        Apps
      </.link>
      <.link navigate={~p"/demo/products"} class="hover:text-orange-400 transition-colors">
        Demo
      </.link>
    </div>
  </div>
</nav>
<main class="bg-slate-950 min-h-screen">
  <div class="max-w-6xl mx-auto px-4 py-6">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
