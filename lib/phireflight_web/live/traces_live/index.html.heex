<.header>
  Traces for <%= @app.name %>
  <:actions>
    <.link navigate={~p"/apps/#{@app.id}"}>
      <.button>Back to App</.button>
    </.link>
  </:actions>
</.header>

<!-- Filter -->
<div class="mb-4">
  <.simple_form for={%{}} phx-change="filter" id="filter-form">
    <.input
      type="select"
      name="status"
      value={@status_filter}
      options={[
        "All": "",
        "OK": "ok",
        "Error": "error",
        "Timeout": "timeout",
        "Cancelled": "cancelled"
      ]}
      label="Filter by Status"
    />
  </.simple_form>
</div>

<.table id="traces" rows={@traces}>
  <:col :let={trace} label="Entry Point"><%= trace.entry_point %></:col>
  <:col :let={trace} label="Status">
    <.status_badge status={trace.status} />
  </:col>
  <:col :let={trace} label="Duration"><%= trace.duration_ms || 0 %>ms</:col>
  <:col :let={trace} label="Started">
    <%= if trace.started_at do %>
      <%= Calendar.strftime(trace.started_at, "%Y-%m-%d %H:%M:%S") %>
    <% else %>
      -
    <% end %>
  </:col>
  <:action :let={trace}>
    <.link navigate={~p"/apps/#{@app.id}/traces/#{trace.id}"}>
      View Flight →
    </.link>
  </:action>
</.table>

<%= if length(@traces) == 0 do %>
  <div class="text-center text-gray-500 dark:text-gray-400 py-8">
    No traces found. Traces will appear here once your app starts sending them.
  </div>
<% end %>

