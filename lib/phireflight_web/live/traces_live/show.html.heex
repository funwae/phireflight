<!-- Top Bar -->
<div class="mb-6 pb-6 border-b border-slate-800">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-100 tracking-tight mb-1">
        Flight #<%= String.slice(@trace.id, 0..8) %>
      </h1>
      <p class="text-sm text-slate-400">
        <%= @trace.entry_point %> • <%= @trace.duration_ms || 0 %>ms •
        <.status_badge status={@trace.status} />
      </p>
      <p class="text-xs text-slate-500 mt-2">
        This is a single flight: one request flowing through your Phoenix contexts.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <.button phx-click="generate_narration" disabled={@generating_narration} class="bg-orange-500 hover:bg-orange-600 text-white">
        <%= if @generating_narration, do: "Generating...", else: "Generate Narration" %>
      </.button>
      <.link navigate={~p"/apps/#{@app.id}"} class="text-slate-400 hover:text-slate-300 text-sm">
        ← Back to App
      </.link>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Left: Context Diagram (2/3 width) -->
  <div class="lg:col-span-2">
    <.live_component
      module={PhireFlightWeb.FlightDiagramComponent}
      id="flight-diagram"
      context_flow={@context_flow}
      events={@events}
      selected_event_id={if(@selected_event, do: @selected_event.id, else: nil)}
    />
  </div>

  <!-- Right: Timeline & Narration (1/3 width) -->
  <div class="space-y-6">
    <!-- Flight Timeline -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
      <h3 class="text-lg font-semibold text-slate-100 mb-4">Flight Timeline</h3>
      <div class="space-y-1 max-h-96 overflow-y-auto">
        <%= for {event, index} <- Enum.with_index(@events) do %>
          <div
            class={[
              "p-3 rounded cursor-pointer transition-colors border-l-2",
              if(index == @current_event_index,
                do: "bg-orange-500/20 border-orange-500",
                else: "bg-slate-800/50 border-slate-700 hover:bg-slate-800"
              ),
              if(@selected_event && @selected_event.id == event.id,
                do: "ring-2 ring-orange-500",
                else: ""
              ),
              if(event.error, do: "border-l-red-500", else: "")
            ]}
            phx-click="select_event"
            phx-value-event_id={event.id}
          >
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="text-xs text-slate-400 font-mono mb-1">
                  T+<%= Enum.at(@time_offsets, index) || 0 %>ms
                </div>
                <div class="font-mono text-sm text-slate-200">
                  <%= event.module %>.<%= event.function %>/<%= event.arity %>
                </div>
                <div class="text-xs text-slate-400 mt-1">
                  <%= String.capitalize(to_string(event.event_type)) %> • <%= event.duration_ms || 0 %>ms
                </div>
              </div>
              <%= if event.error do %>
                <.icon name="hero-exclamation-circle" class="w-5 h-5 text-red-500 flex-shrink-0" />
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- AI Narration -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
      <h3 class="text-lg font-semibold text-slate-100 mb-4">AI Narration</h3>
      <%= if @narration do %>
        <div class="space-y-4">
          <div>
            <h4 class="text-sm font-semibold text-slate-300 mb-2">Summary</h4>
            <p class="text-sm text-slate-400 leading-relaxed">
              <%= @narration.summary %>
            </p>
          </div>
          <%= if @narration.details do %>
            <div>
              <h4 class="text-sm font-semibold text-slate-300 mb-2">Details</h4>
              <p class="text-sm text-slate-400 leading-relaxed">
                <%= @narration.details %>
              </p>
            </div>
          <% end %>
          <%= if @narration.issues && length(@narration.issues) > 0 do %>
            <div>
              <h4 class="text-sm font-semibold text-slate-300 mb-2">Issues</h4>
              <ul class="space-y-1">
                <%= for issue <- @narration.issues do %>
                  <li class="text-xs text-slate-400 flex items-start gap-2">
                    <span class="text-red-400">•</span>
                    <span><%= issue %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-slate-400 mb-4 text-sm">
          No narration yet. Click "Generate Narration" to have an AI explain this flight.
        </p>
        <.button phx-click="generate_narration" disabled={@generating_narration} class="w-full bg-orange-500 hover:bg-orange-600 text-white">
          <%= if @generating_narration, do: "Generating...", else: "Generate Narration" %>
        </.button>
      <% end %>
    </div>
  </div>
</div>

