<div class="mb-8">
  <div class="flex items-center justify-between mb-2">
    <div>
      <h1 class="text-3xl font-semibold text-slate-100 tracking-tight">Contexts</h1>
      <p class="text-slate-400 text-sm mt-1">Bounded contexts for <%= @app.name %></p>
    </div>
    <div class="flex gap-3">
      <.link patch={~p"/apps/#{@app.id}/contexts/new"} class="inline-flex items-center rounded-md bg-orange-500 px-3 py-2 text-sm font-semibold text-white hover:bg-orange-600">
        New Context
      </.link>
      <.link navigate={~p"/apps/#{@app.id}"} class="text-sm text-slate-400 hover:text-slate-300">
        ← Back to App
      </.link>
    </div>
  </div>
</div>

<div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
  <table class="w-full">
    <thead class="bg-slate-800 border-b border-slate-700">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Name</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Full Name</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Kind</th>
        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Color</th>
        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-400 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-800">
      <%= for {_id, context} <- @streams.contexts do %>
        <tr class="hover:bg-slate-800/50 transition-colors">
          <td class="px-4 py-3 text-sm font-semibold text-slate-100"><%= context.name %></td>
          <td class="px-4 py-3 text-sm font-mono text-slate-400"><%= context.full_name || "-" %></td>
          <td class="px-4 py-3">
            <span class={[
              "text-xs px-2 py-1 rounded",
              context.kind == :domain && "bg-blue-500/20 text-blue-400 border border-blue-500/30",
              context.kind == :integration && "bg-purple-500/20 text-purple-400 border border-purple-500/30",
              context.kind == :ui && "bg-green-500/20 text-green-400 border border-green-500/30",
              context.kind == :infra && "bg-slate-700 text-slate-300 border border-slate-600"
            ]}>
              <%= String.capitalize(to_string(context.kind)) %>
            </span>
          </td>
          <td class="px-4 py-3">
            <div class="w-6 h-6 rounded border border-slate-700" style={"background-color: #{context.color || '#3B82F6'}"}></div>
          </td>
          <td class="px-4 py-3 text-right">
            <div class="flex gap-2 justify-end">
              <.link patch={~p"/apps/#{@app.id}/contexts/#{context.id}/edit"} class="text-sm text-slate-400 hover:text-slate-300">
                Edit
              </.link>
              <.link
                phx-click={JS.push("delete", value: %{id: context.id}) |> hide("##{context.id}")}
                data-confirm="Are you sure?"
                class="text-sm text-red-400 hover:text-red-300"
              >
                Delete
              </.link>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= if Enum.empty?(@streams.contexts) do %>
  <div class="text-center py-16">
    <p class="text-slate-400 mb-2">No contexts defined yet.</p>
    <p class="text-slate-500 text-sm mb-4">Contexts represent the bounded contexts in your application architecture.</p>
    <.link patch={~p"/apps/#{@app.id}/contexts/new"} class="inline-flex items-center rounded-md bg-orange-500 px-3.5 py-2.5 text-sm font-semibold text-white hover:bg-orange-600">
      Create Your First Context
    </.link>
  </div>
<% end %>

<.modal :if={@live_action in [:new, :edit]} id="context-modal" show on_cancel={JS.patch(~p"/apps/#{@app.id}/contexts")}>
  <.live_component
    module={PhireFlightWeb.ContextsLive.FormComponent}
    id={@app_context.id || :new}
    title={@page_title}
    action={@live_action}
    app_context={@app_context}
    app={@app}
    patch={~p"/apps/#{@app.id}/contexts"}
  />
</.modal>
