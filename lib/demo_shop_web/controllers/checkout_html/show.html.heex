<div class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <h1 class="text-3xl font-bold mb-8">Checkout</h1>

    <%= if length(@cart.cart_items) == 0 do %>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-8 text-center">
        <p class="text-gray-600 dark:text-gray-400 mb-4">Your cart is empty.</p>
        <.link navigate={~p"/demo/products"} class="text-blue-600 hover:text-blue-800">
          Browse Products →
        </.link>
      </div>
    <% else %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Cart Items -->
        <div class="lg:col-span-2">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold mb-4">Cart Items</h2>
            <div class="space-y-4">
              <%= for item <- @cart.cart_items do %>
                <div class="flex items-center justify-between border-b pb-4">
                  <div>
                    <h3 class="font-semibold"><%= item.product.name %></h3>
                    <p class="text-sm text-gray-500">Quantity: <%= item.quantity %></p>
                  </div>
                  <div class="text-right">
                    <p class="font-semibold">$<%= :erlang.float_to_binary(item.quantity * item.product.price_cents / 100, decimals: 2) %></p>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="mt-6 pt-4 border-t">
              <div class="flex justify-between text-xl font-bold">
                <span>Total:</span>
                <span>$<%= :erlang.float_to_binary(Enum.reduce(@cart.cart_items, 0, fn item, acc -> acc + (item.quantity * item.product.price_cents) end) / 100, decimals: 2) %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Checkout Form -->
        <div class="lg:col-span-1">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold mb-4">Payment</h2>
            <.form for={%{}} action={~p"/demo/checkout"} method="post" class="space-y-4">
              <div>
                <label class="block text-sm font-medium mb-2">Payment Method</label>
                <select name="payment_method" required class="w-full rounded-md border border-gray-300 px-3 py-2">
                  <option value="card">Credit Card</option>
                  <option value="paypal">PayPal</option>
                </select>
              </div>

              <div>
                <label class="flex items-center">
                  <input type="checkbox" name="use_good_flow" value="true" checked class="mr-2" />
                  <span class="text-sm">Use good flow (proper context boundaries)</span>
                </label>
                <p class="text-xs text-gray-500 mt-1">Uncheck to see bad flow (anti-patterns)</p>
              </div>

              <button type="submit" class="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
                Complete Order
              </button>
            </.form>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

